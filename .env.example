# Copy to .env.local for development, and set the same two values in
# Netlify under Site configuration -> Environment variables.
#
# Both are inlined into the JavaScript bundle at build time. The anon key
# is designed to be public — what actually controls access is the row level
# security policy in supabase/schema.sql. Read the warning in that file.
#
# Leave these unset and the app falls back to localStorage, which is a
# perfectly good way to run a test on one laptop.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# optional shared passphrase; leave unset for no gate
VITE_PASSPHRASE=
